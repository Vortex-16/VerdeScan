{
  "name": "forest_model",
  "version": "2.0.0",
  "architecture": "resnet18",
  "num_classes": 3,
  "class_names": ["alive", "dead", "no_sapling"],
  "class_indices": {"alive": 0, "dead": 1, "no_sapling": 2},
  "input_size": [224, 224],
  "input_channels": 3,
  "normalize_mean": [0.485, 0.456, 0.406],
  "normalize_std": [0.229, 0.224, 0.225],
  "head": "Dropout(0.3) + Linear(512 -> 3)",
  "pretrained_backbone": "ImageNet (torchvision ResNet18_Weights.IMAGENET1K_V1)",
  "training": {
    "dataset": "processed_dataset_v2",
    "tiles_per_class": 5000,
    "total_tiles": 15000,
    "tile_size": 224,
    "split": "source-image-level 80/20",
    "optimizer": "Adam",
    "lr": 1e-4,
    "weight_decay": 1e-4,
    "scheduler": "ReduceLROnPlateau(patience=2, factor=0.5)",
    "mixed_precision": "AMP FP16",
    "early_stopping_patience": 5,
    "stopped_epoch": 8,
    "max_epochs": 15,
    "batch_size": 128
  },
  "performance": {
    "val_accuracy": 0.999,
    "val_loss": 0.0003,
    "precision_alive": 1.000,
    "recall_alive": 1.000,
    "f1_alive": 1.000,
    "precision_dead": 1.000,
    "recall_dead": 1.000,
    "f1_dead": 1.000
  },
  "sites": ["Benkmura VF", "Debadihi VF"],
  "kaggle_model": "https://www.kaggle.com/models/dealer09/verdescan-forest-model",
  "kaggle_dataset": "https://www.kaggle.com/datasets/dealer09/verdescan-afforestation-tiles",
  "trained_date": "2026-06-02",
  "framework": "PyTorch",
  "notes": "Replacing this file: run train_improved.py then cp forest_model_improved.pth forest_model.pth. Bump version field before committing."
}
